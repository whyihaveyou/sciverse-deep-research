{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "brief",
  "description": "M2 Node A brief_freeze 冻结的研究简报（规格 M2_ORCHESTRATION_SPEC.md §2）",
  "type": "object",
  "required": ["schema_version", "topic", "rq", "sources", "output_format", "audience"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "rq": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "perspectives": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["sciverse", "arxiv", "openalex", "crossref"]}
    },
    "criteria": {"type": "object"},
    "output_format": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1}
  }
}
